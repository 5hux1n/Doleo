#!@SHEBANG@
# Doleo —— APT 钩子（DPkg::Pre-Install-Pkgs）
#
# APT 在调用 dpkg 安装之前，会把即将安装的 deb 路径逐行写到本脚本的标准输入。
# 对于其中"已安装且版本不同"的包（即升级或降级），先把当前已安装的版本备份到仓库：
#   1. 优先从 APT 缓存里找原始 deb
#   2. 找不到就根据已安装的文件重新打包
#
# 这个脚本无论如何都以 0 退出，绝不能让升级因为备份失败而中断。

ROOT="@ROOT@"
DATA="$ROOT@DATA_DIR@"
ARCHIVE="$DATA/archive"
LOG="$DATA/backup.log"
CACHE="$ROOT/var/cache/apt/archives"
INFO="$ROOT/var/lib/dpkg/info"
MOBILE_ID="501:501"

PATH="$ROOT/usr/bin:$ROOT/bin:$ROOT/usr/sbin:$ROOT/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# 先完整读完标准输入，避免 APT 写入时收到 SIGPIPE
LIST=$(cat)

[ -d "$ARCHIVE" ] || exit 0
[ -e "$DATA/autobackup.off" ] && [ ! -e "$DATA/installbackup.on" ] && exit 0

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r\t'
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" 2>/dev/null | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1
    fi
}

# 根据已安装的文件重新打包：$1=包名 $2=输出路径
rebuild() {
    r_pkg=$1
    r_out=$2
    mkdir -p "$DATA/tmp" 2>/dev/null
    r_work=$(mktemp -d "$DATA/tmp/rebuild.XXXXXX" 2>/dev/null) || return 1
    # mktemp 建的是 0700，会被原样打进包的根目录，改回 0755
    chmod 0755 "$r_work"
    mkdir -p "$r_work/DEBIAN"

    # 控制信息：去掉只属于 dpkg 状态库的字段（含多行的 Conffiles）
    dpkg-query -s "$r_pkg" 2>/dev/null | awk '
        /^[^ \t]/ { skip = ($0 ~ /^(Status|Config-Version|Conffiles):/) }
        !skip { print }
    ' >"$r_work/DEBIAN/control"
    if [ ! -s "$r_work/DEBIAN/control" ]; then
        rm -rf "$r_work"
        return 1
    fi

    # 文件：dpkg -L 列出的目录、文件和符号链接，保留权限和属主
    dpkg-query -L "$r_pkg" 2>/dev/null | while IFS= read -r p; do
        case "$p" in /*) ;; *) continue ;; esac
        if [ -d "$p" ] && [ ! -L "$p" ]; then
            mkdir -p "$r_work$p"
        elif [ -e "$p" ] || [ -L "$p" ]; then
            mkdir -p "$r_work$(dirname "$p")"
            cp -P -p "$p" "$r_work$p" 2>/dev/null
        fi
    done

    # 维护者脚本和 conffiles（多架构时文件名带 :arch）
    for f in preinst postinst prerm postrm triggers conffiles shlibs; do
        for src in "$INFO/$r_pkg.$f" "$INFO/$r_pkg:"*".$f"; do
            if [ -f "$src" ]; then
                cp -p "$src" "$r_work/DEBIAN/$f"
                break
            fi
        done
    done

    dpkg-deb -Zgzip -b "$r_work" "$r_out" >/dev/null 2>&1
    r_status=$?
    rm -rf "$r_work"
    return $r_status
}

# 备份当前已安装版本：$1=包名 $2=版本 $3=架构
backup() {
    b_pkg=$1
    b_ver=$2
    b_arch=$3
    b_dir="$ARCHIVE/$b_pkg"
    b_encver=$(printf '%s' "$b_ver" | sed 's/:/%3a/g')
    b_base="${b_pkg}_${b_encver}_${b_arch}"
    b_out="$b_dir/$b_base.deb"

    [ -f "$b_out" ] && return 0
    mkdir -p "$b_dir" || return 1

    b_origin=""
    if [ -n "${4:-}" ]; then
        if ! cp "$4" "$b_out.part" || ! mv "$b_out.part" "$b_out"; then
            rm -f "$b_out.part"
            log "Failed $b_pkg $b_ver: cannot copy installation package"
            return 1
        fi
        b_origin="install"
    fi
    for c in "$CACHE/${b_pkg}_${b_encver}_"*.deb; do
        [ -n "$b_origin" ] && break
        [ -f "$c" ] || continue
        if [ "$(dpkg-deb -f "$c" Version 2>/dev/null)" = "$b_ver" ]; then
            cp "$c" "$b_out.part" && mv "$b_out.part" "$b_out" && b_origin="apt-cache"
            break
        fi
    done

    if [ -z "$b_origin" ]; then
        if rebuild "$b_pkg" "$b_out.part" && mv "$b_out.part" "$b_out"; then
            b_origin="rebuilt"
        else
            rm -f "$b_out.part"
            log "Failed $b_pkg $b_ver: cannot rebuild package"
            return 1
        fi
    fi

    dpkg-deb -f "$b_out" >"$b_dir/$b_base.control" 2>/dev/null
    b_name=$(dpkg-deb -f "$b_out" Name 2>/dev/null)
    b_sum=$(sha256_of "$b_out")
    b_note="Automatic backup before upgrade"
    [ "$b_origin" = "install" ] && b_note="Automatic backup on installation"
    cat >"$b_dir/$b_base.json" <<EOF
{"package":"$(json_escape "$b_pkg")","version":"$(json_escape "$b_ver")","architecture":"$(json_escape "$b_arch")","name":"$(json_escape "$b_name")","origin":"$b_origin","sha256":"$b_sum","verified":false,"savedAt":$(date +%s),"note":"$b_note"}
EOF
    chown -R "$MOBILE_ID" "$b_dir" 2>/dev/null
    log "Saved $b_pkg $b_ver ($b_origin)"
    return 0
}

printf '%s\n' "$LIST" | while IFS= read -r deb; do
    case "$deb" in *.deb) ;; *) continue ;; esac
    [ -f "$deb" ] || continue

    pkg=$(dpkg-deb -f "$deb" Package 2>/dev/null)
    newver=$(dpkg-deb -f "$deb" Version 2>/dev/null)
    [ -n "$pkg" ] || continue

    if [ -e "$DATA/installbackup.on" ]; then
        newarch=$(dpkg-deb -f "$deb" Architecture 2>/dev/null)
        if [ -n "$newver" ] && [ -n "$newarch" ]; then
            backup "$pkg" "$newver" "$newarch" "$deb"
        fi
    fi
    [ -e "$DATA/autobackup.off" ] && continue

    # 输出形如：install ok installed 1.2.3 iphoneos-arm64
    st=$(dpkg-query -W -f='${Status} ${Version} ${Architecture}' "$pkg" 2>/dev/null) || continue
    set -- $st
    [ "$3" = "installed" ] || continue
    curver=$4
    curarch=$5
    [ -n "$curver" ] || continue
    [ "$curver" = "$newver" ] && continue

    backup "$pkg" "$curver" "$curarch"
done

exit 0
