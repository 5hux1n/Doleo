#!@SHEBANG@
# Doleo 安装后脚本：创建仓库目录并交给 mobile 用户（Sileo 以 mobile 身份运行）

ROOT="@ROOT@"
DATA="$ROOT@DATA_DIR@"

case "$1" in
    configure)
        mkdir -p "$DATA/archive" "$DATA/tmp" || exit 1
        chown 501:501 "$DATA" "$DATA/archive" "$DATA/tmp"
        chmod 0755 "$DATA" "$DATA/archive" "$DATA/tmp"
        [ -f "$DATA/settings.json" ] && chown 501:501 "$DATA/settings.json"

        # 1.0.x 的自动备份靠 APT 钩子（DPkg::Pre-Install-Pkgs），钩子由 APT 用写死的 /bin/sh 运行，
        # 在 rootless 上根本起不来，会让整台设备的安装/升级/卸载以 error code 100 失败。
        # 新版改为装完之后由 app 补存，钩子必须彻底清掉，包括已发布版本留下的文件和用户手动改名的副本。
        rm -f "$ROOT/usr/libexec/doleo/prebackup" \
              "$ROOT/etc/apt/apt.conf.d/99doleo" \
              "$ROOT/etc/apt/apt.conf.d/99doleo.disabled" \
              "$DATA/hook.off"
        # 旧版本的开关标记留给 app 迁移（DKSettings.migrateLegacyOnce），不要在这里删。
        [ -f "$DATA/autobackup.off" ] && chown 501:501 "$DATA/autobackup.off"
        [ -f "$DATA/installbackup.on" ] && chown 501:501 "$DATA/installbackup.on"
        ;;
esac

exit 0
